body { margin: 0px; min-width: 320px; background: radial-gradient(circle at 5% 0%,#19795714,transparent 22rem),radial-gradient(circle at 96% 22%,#b4312d14,transparent 20rem),var(--paper); color: var(--ink); font-family: Manrope, Arial, sans-serif; -webkit-font-smoothing: antialiased; }

button { font: inherit; }

button, a { -webkit-tap-highlight-color: transparent; }

.shell { min-height: 100vh; overflow-x: hidden; }

.container { width: min(920px, 100% - 32px); margin: auto; }

.nav-wrap { padding-top: 16px; }

.nav { display: grid; grid-template-columns: repeat(6, minmax(0px, 1fr)); gap: 4px; padding: 4px; border: 1px solid rgb(221, 220, 212); border-radius: 16px; background: rgb(238, 234, 225); }

.nav button { min-width: 0px; min-height: 36px; padding: 8px 4px; border: 0px; border-radius: 12px; background: transparent; color: rgb(100, 113, 108); cursor: pointer; font-size: 12px; font-weight: 800; line-height: 1.1; white-space: nowrap; }

.nav button:hover, .nav button.active { background: var(--ink); color: rgb(255, 250, 241); }

.nav button:nth-child(-n+3) { grid-column: span 2; }

.nav button:nth-child(4) { grid-column: 2 / span 2; }

.nav button:nth-child(5) { grid-column: 4 / span 2; }

.controls { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 20px 0px 10px; }

.sort-label { color: rgb(119, 134, 127); font: 500 10px "DM Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }

.sort button { border: 1px solid rgb(217, 226, 220); border-radius: 999px; padding: 8px 13px; background: rgb(231, 238, 232); color: rgb(97, 113, 106); cursor: pointer; font-size: 11px; font-weight: 800; }

.sort button.active { background: var(--ink); color: rgb(255, 250, 241); }

.cards { display: grid; gap: 10px; padding: 0px 0px 64px; }

.card { display: grid; grid-template-columns: 86px minmax(0px, 1fr) minmax(128px, 200px); align-items: center; gap: 16px; position: relative; min-width: 0px; padding: 16px 16px 16px 20px; border: 1px solid rgb(227, 227, 220); border-radius: 22px; background: rgb(255, 255, 255); box-shadow: rgba(28, 40, 31, 0.055) 0px 5px 18px; animation: 0.45s ease 0s 1 normal both running rise; }

.number { position: absolute; top: 16px; left: -9px; z-index: 1; display: grid; place-items: center; min-width: 30px; height: 30px; padding: 0px 6px; border-radius: 99px; background: rgb(198, 45, 46); color: rgb(255, 255, 255); font: 700 11px "DM Mono", monospace; }

.image { width: 86px; height: 86px; overflow: hidden; border-radius: 17px; }

.image img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center center; }

.details { min-width: 0px; }

.name { margin: 0px; color: rgb(23, 27, 26); font: 700 clamp(1rem, 2.2vw, 1.55rem) / 1.05 "Space Grotesk", Arial, sans-serif; letter-spacing: -0.045em; overflow-wrap: anywhere; }

.meta { display: grid; gap: 5px; margin-top: 10px; color: rgb(23, 27, 26); font-size: clamp(0.72rem, 1.4vw, 0.98rem); font-weight: 700; line-height: 1.15; }

.meta-line { display: flex; min-width: 0px; align-items: center; gap: 7px; }

.bonus { color: rgb(198, 45, 46); }

.icon { width: 17px; height: 17px; flex: 0 0 17px; }

.download { display: flex; min-height: 56px; width: 100%; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; border-radius: 14px; background: var(--green); color: rgb(255, 255, 255); font-size: clamp(0.78rem, 1.6vw, 1.2rem); font-weight: 800; text-decoration: none; box-shadow: rgba(0, 0, 0, 0.35) 0px -2px inset, rgba(28, 40, 31, 0.16) 0px 5px 12px; transition: 0.2s; }

.download:hover { background: rgb(18, 98, 71); transform: translateY(-2px); }

.download svg { width: 16px; height: 16px; flex: 0 0 16px; }

.info { width: min(920px, 100% - 32px); margin: 32px auto 64px; padding: 40px; border: 1px solid var(--line); border-radius: 24px; background: rgb(255, 255, 255); box-shadow: rgba(28, 40, 31, 0.05) 0px 8px 24px; }

.eyebrow { margin: 0px; color: var(--red); font: 500 10px "DM Mono", monospace; letter-spacing: 0.16em; text-transform: uppercase; }

.info h1 { max-width: 680px; margin: 12px 0px 0px; font: 700 clamp(1.65rem, 5vw, 3.1rem) / 0.98 "Space Grotesk", Arial, sans-serif; letter-spacing: -0.06em; }

.info p { max-width: 680px; margin: 20px 0px 0px; color: var(--muted); font-size: 16px; line-height: 1.7; }

.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }

.tag { padding: 9px 12px; border-radius: 99px; background: var(--soft); color: rgb(54, 80, 75); font-size: 12px; font-weight: 800; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

@media (min-width: 640px) {
  .nav-wrap { padding-top: 24px; }
  .nav { grid-template-columns: repeat(5, minmax(0px, 1fr)); }
  .nav button { min-height: 40px; padding: 10px 6px; font-size: 13px; grid-column: auto !important; }
  .controls { padding-top: 32px; }
}

@media (max-width: 639px) {
  .container { width: calc(100% - 24px); }
  .controls { padding-top: 18px; }
  .card { grid-template-columns: 76px minmax(0px, 1fr) minmax(91px, 96px); gap: 10px; padding: 12px 10px 12px 15px; border-radius: 21px; }
  .image { width: 76px; height: 76px; border-radius: 15px; }
  .name { font-size: 0.98rem; }
  .meta { gap: 4px; margin-top: 8px; font-size: 0.68rem; }
  .meta-line { gap: 5px; }
  .icon { width: 14px; height: 14px; flex-basis: 14px; }
  .download { min-height: 50px; padding: 10px 7px; border-radius: 13px; font-size: 0.75rem; }
  .download svg { width: 14px; height: 14px; flex-basis: 14px; }
  .info { margin-top: 24px; padding: 28px 20px; border-radius: 22px; }
  .info p { font-size: 14px; line-height: 1.65; }
}

@media (max-width: 380px) {
  .nav button { font-size: 11px; }
  .card { grid-template-columns: 72px minmax(0px, 1fr) minmax(86px, 91px); gap: 8px; padding-right: 8px; }
  .image { width: 72px; height: 72px; }
  .download { padding-inline: 5px; font-size: 0.7rem; }
  .sort-label { display: none; }
}
